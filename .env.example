# Настройки сайта записи на пробные уроки SanArt.
#
# Где задавать:
#   • на Vercel — Project Settings → Environment Variables, затем Deployments → Redeploy
#     (без Redeploy новые значения не подхватываются);
#   • локально (для node tools/list.js и tools/check.js) — скопируйте этот файл в .env и заполните.
#     Файл .env не попадает ни в git, ни на Vercel.
#
# Узнать все ID (группы, кабинеты, статусы, источники):  node tools/list.js


# ===================== ОБЯЗАТЕЛЬНЫЕ =====================

# Ключ API МойКласс: МойКласс → Настройки → API → ключ.
MOYKLASS_API_KEY=

# Секрет для подписи ссылок отмены — любая длинная случайная строка, например результат
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Не меняйте без необходимости: после смены старые ссылки отмены из WhatsApp перестанут открываться.
SIGNING_SECRET=

# ---------- Инструменты и кабинеты ----------
# Какие инструменты показывать и в каких кабинетах можно проводить пробный урок.
# Инструмент = группа МойКласс (название кнопки берётся из названия группы).
#
# Формат:  группа:кабинет,кабинет;группа:кабинет;группа
#   • группы разделяются точкой с запятой «;»
#   • после двоеточия — кабинеты этой группы через запятую, в порядке приоритета
#     (запись займёт первый свободный из списка)
#   • группа без кабинетов = все активные кабинеты филиала
#   • порядок групп = порядок кнопок на странице
#
# ID школы (из node tools/list.js):
#   группы:   163997 Вокал · 164076 Гитара · 230182 Фортепиано
#   кабинеты: 33466 NY · 33467 CUB · 33468 STUDIO · 33469 GUITAR   (активные)
#
# Примеры:
#   вокал только в NY и STUDIO, гитара сначала в GUITAR, потом в CUB, фортепиано — где свободно:
#     MOYKLASS_TRIAL_GROUPS=163997:33466,33468;164076:33469,33467;230182
#   все инструменты во всех активных кабинетах:
#     MOYKLASS_TRIAL_GROUPS=163997;164076;230182
#
# Если указать несуществующую группу или архивный кабинет, сайт покажет ошибку config с пояснением.
MOYKLASS_TRIAL_GROUPS=163997;164076;230182


# ===================== ЗАПИСЬ =====================

# Статус записи ученика в группу (node tools/list.js → «Статусы записи в группу»).
# Пусто — ищется статус со словом «Проб»; в школе такого нет, поэтому указан 41075 «Записан».
MOYKLASS_JOIN_STATUS_ID=41075

# Источник «откуда узнали» для новых учеников с сайта и из Instagram-бота (ссылка с ?ig=…).
# Пусто — не указывается. Для Instagram пусто — берётся MOYKLASS_SOURCE_ID.
MOYKLASS_SOURCE_ID=
MOYKLASS_SOURCE_ID_IG=

# Рабочий день школы (по времени Алматы). Пробный урок целиком помещается внутри.
WORK_START=10:00
WORK_END=22:00

# Длительность пробного урока и шаг сетки (минуты): 10:00, 10:15, … 21:15.
TRIAL_MINUTES=45
SLOT_STEP_MINUTES=15

# Сколько дней показывать (неделя) и на сколько недель вперёд искать, если неделя занята.
BOOKING_DAYS=7
SEARCH_WEEKS=8

# За сколько часов до урока закрываются запись и отмена (позже отмена невозможна — пробный сгорает).
BOOKING_CUTOFF_HOURS=3


# ===================== WHATSAPP (GREEN-API) =====================
# Если GREEN_* не заданы, сообщения просто не отправляются (запись работает).

# Адрес API инстанса, например https://7105.api.greenapi.com, его ID и токен — из кабинета green-api.com.
GREEN_URL=
GREEN_ID=
GREEN_TOKEN=

# Кому писать о новых записях, отменах и незавершённых заявках:
# номера 77011234567 или ID группы WhatsApp 1234567890-1234567890@g.us, через запятую.
ADMIN_WHATSAPP=


# ===================== ПРОЧЕЕ =====================

# Адрес сайта для ссылок отмены в сообщениях (без «/» в конце). Пусто — домен, на который пришёл запрос.
PUBLIC_URL=

# Секрет для /api/cron (напоминания). Vercel Cron передаёт его сам, если переменная задана в проекте.
# Внешний планировщик: https://<сайт>/api/cron?key=<CRON_SECRET>. Пусто — напоминания не работают.
CRON_SECRET=

# daily — раз в день (13:00 Алматы) напомнить обо всех пробных уроках завтра (подходит для Vercel Hobby);
# hourly — напоминать за 24–25 ч до урока (нужен почасовой вызов /api/cron внешним планировщиком).
REMINDER_MODE=daily

# Только для тестов: адрес мок-сервера вместо https://api.moyklass.com.
# MOYKLASS_API_URL=
